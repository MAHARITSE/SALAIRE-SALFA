{
  "name": "salfa-web-paie",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Logiciel de Paie Mensuelle CLINIQUE SALFA TANAMBAO — 100% local (navigateur), déployable sur Cloudflare Pages",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run typecheck && vite build",
    "build:wamp": "npm run typecheck && vite build --mode wamp --base=./",
    "package:wamp": "npm run test:wamp-build && node scripts/packager-wamp.cjs && node scripts/verifier-paquet-wamp.cjs",
    "sql:conges": "node scripts/generer_sql_conges_wamp.cjs",
    "contrat:modele": "node scripts/preparer-modele-contrat.cjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name salfa-web-paie",
    "deploy:workers": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "test:wamp-build": "npm run build:wamp && node scripts/verifier-build-wamp.cjs",
    "test:sql": "python3 scripts/test_sql_paies_cloturees.py",
    "personnel:completer": "node scripts/completer-personnel.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.16.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "wrangler": "^4.120.0"
  }
}
